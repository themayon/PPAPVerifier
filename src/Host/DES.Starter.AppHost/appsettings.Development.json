{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Infrastructure": {
    "Postgres": {
      "Mode": "External",
      "ConnectionString": "Host=localhost;Port=5432;Database=fsh;Username=postgres;Password=sa;Include Error Detail=true"
    },
    "Redis": {
      "Mode": "None",
      "ConnectionString": ""
    },
    "RabbitMQ": {
      "Mode": "Container"
    },
    "Storage": {
      "Mode": "Minio",
      "S3": {
        "ServiceUrl": "",
        "Bucket": "",
        "Region": "us-east-1",
        "AccessKey": "",
        "SecretKey": "",
        "ForcePathStyle": true
      }
    }
  },
  "ExternalExtractors": {
    "Aspect": {
      "Enabled": true,
      "Venv": "Venv_LLM_Extraction",
      "Port": 8001,
      "Provider": "gemini",
      "Model": "gemini-3.1-pro-preview",
      "UseAsyncTaskApi": true
    },
    "Diagram": {
      "Enabled": true,
      "Venv": "Venv_DiagramExtractorAPI",
      "Port": 8002,
      "Provider": "gemini",
      "Model": "gemini-3.1-pro-preview"
    }
  }
}