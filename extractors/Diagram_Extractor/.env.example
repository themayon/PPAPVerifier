OPENAI_ENDPOINT="https://your-azure-openai-endpoint.example.com/"
OPENAI_API_KEY="replace-with-provider-key"
X-API-KEY="replace-with-generated-api-key"
MASTER-KEY="replace-with-generated-master-key"
DB_CONN_URL="postgresql://username:password@postgres:5432/database"
CELERY_BROKER_URL="amqp://username:password@rabbitmq:5672/"
CELERY_RESULT_BACKEND="rpc://"
WEBHOOK_SIGNING_ENABLED="false"
WEBHOOK_SIGNING_SECRET="replace-with-generated-webhook-secret"
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS="300"
