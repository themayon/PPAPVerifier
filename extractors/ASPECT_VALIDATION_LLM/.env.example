ASPECT_API_KEY=replace-with-generated-api-key
ASPECT_MAX_UPLOAD_BYTES=26214400
GPT4O_KEY=replace-with-provider-key
GPT4O_ENDPOINT=https://your-azure-openai-endpoint.example.com
GPT4O_API_VERSION=replace-with-api-version
GEMINI_API_KEY=replace-with-provider-key
GEMINI_MODEL=replace-with-model-name
LLM_DB_SERVER=replace-with-server
LLM_DB_NAME=replace-with-database
LLM_DB_USERNAME=replace-with-username
LLM_DB_PASSWORD=replace-with-password
LLM_DB_DRIVER=ODBC Driver 17 for SQL Server
# Durable asynchronous task metadata and artifacts (default: ./extraction_task_data)
ASPECT_TASK_STORAGE_DIR=D:\\path\\to\\private\\aspect-task-storage
# Absolute path is recommended; "soffice" is also accepted when it is on PATH.
ASPECT_SOFFICE_EXECUTABLE=C:\\Program Files\\LibreOffice\\program\\soffice.exe
ASPECT_OFFICE_CONVERSION_TIMEOUT_SECONDS=120
